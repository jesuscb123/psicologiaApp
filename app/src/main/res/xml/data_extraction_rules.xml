<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas de extracción de datos para la app de psicología (API >= 31).
    allowBackup=false en el Manifest es la primera línea de defensa para proteger los datos
    clínicos. Estas reglas se conservan como documentación de política y garantía por si
    allowBackup se reactiva en el futuro.

    Se excluyen explícitamente:
      - La base de datos Room (notas, tareas, pacientes, psicólogos cacheados).
      - El DataStore de sincronización.
      - Cualquier preferencia compartida (tokens, sesiones parciales).

    Ver: https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="psicologia_app.db"/>
        <exclude domain="database" path="psicologia_app.db-shm"/>
        <exclude domain="database" path="psicologia_app.db-wal"/>
        <exclude domain="file" path="datastore/"/>
        <exclude domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="psicologia_app.db"/>
        <exclude domain="database" path="psicologia_app.db-shm"/>
        <exclude domain="database" path="psicologia_app.db-wal"/>
        <exclude domain="file" path="datastore/"/>
        <exclude domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
